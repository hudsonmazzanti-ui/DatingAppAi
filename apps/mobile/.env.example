# Where apps/api is running. On a phone, use your computer's LAN IP or the deployed URL.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
# OAuth client ids from Google Cloud Console (APIs & Services > Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=
